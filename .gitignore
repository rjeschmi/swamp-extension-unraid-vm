# Swamp runtime data (not needed for reconstruction)
.swamp/data/
.swamp/outputs/
.swamp/workflow-runs/
.swamp/workflows-evaluated/
.swamp/definitions-evaluated/
.swamp/bundles/
.swamp/telemetry/

# Encryption keyfiles (NEVER commit - allows decrypting secrets)
.swamp/secrets/

# Claude Code configuration (managed by swamp)
.claude/

# Vault data
vaults/

# Workflow run history in logical views
workflows/*/runs/

# Model runtime data symlinks in logical views
models/*/outputs/
models/*/source/
models/*/step/
models/*/type/
models/*/modelName/
models/*/specName/
models/*/workflow/

# OpenStack credentials
openrc.sh

# Node modules
node_modules/

# BEGIN swamp managed section - DO NOT EDIT

# Local telemetry (not needed for reconstruction)
.swamp/telemetry/

# Audit command logs (local-only hook data)
.swamp/audit/

# Encryption keyfile (NEVER commit - allows decrypting secrets)
.swamp/secrets/keyfile

# Cached extension bundles (regenerated at runtime)
.swamp/bundles/
.swamp/vault-bundles/

# Claude Code configuration (managed by swamp)
.claude/
# END swamp managed section
